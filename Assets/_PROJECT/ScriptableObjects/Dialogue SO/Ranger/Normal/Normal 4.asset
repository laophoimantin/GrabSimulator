  Nodes:
  - NodeID: Start
    SpeakerName: Ranger
    Text: "You know that Mayor\u2019s brat? Tuan Anh?"
    Choices: []
    DefaultNextNodeID: 1
    EventTrigger: {fileID: 0}
  - NodeID: 1
    SpeakerName: Player
    Text: I know him. Why?
    Choices: []
    DefaultNextNodeID: 2
    EventTrigger: {fileID: 0}
  - NodeID: 2
    SpeakerName: Ranger
    Text: He and his squad brought a cooler up here last week. Drank and shouted
      until midnight!
    Choices: []
    DefaultNextNodeID: 3
    EventTrigger: {fileID: 0}
  - NodeID: 3
    SpeakerName: Player
    Text: Sounds like quite a party.
    Choices: []
    DefaultNextNodeID: 4
    EventTrigger: {fileID: 0}
  - NodeID: 4
    SpeakerName: Ranger
    Text: It was a mess! Empty cans everywhere. He thinks his dad owns the trees!
    Choices: []
    DefaultNextNodeID: 5
    EventTrigger: {fileID: 0}
  - NodeID: 5
    SpeakerName: Player
    Text: I'll stay away from his spots.
    Choices: []
    DefaultNextNodeID: 6
    EventTrigger: {fileID: 0}
  - NodeID: 6
    SpeakerName: Ranger
    Text: "Good. Next time he screams, I\u2019m locking him in the station!"
    Choices: []
    DefaultNextNodeID: 
    EventTrigger: {fileID: 0}
