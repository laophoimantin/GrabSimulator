  Nodes:
  - NodeID: Start
    SpeakerName: Ranger
    Text: You see that flower over there?
    Choices: []
    DefaultNextNodeID: 1
    EventTrigger: {fileID: 0}
  - NodeID: 1
    SpeakerName: Ranger
    Text: Don't touch it! Just look!
    Choices: []
    DefaultNextNodeID: 2
    EventTrigger: {fileID: 0}
  - NodeID: 2
    SpeakerName: Player
    Text: It is beautiful. I never see that color before.
    Choices: []
    DefaultNextNodeID: 3
    EventTrigger: {fileID: 0}
  - NodeID: 3
    SpeakerName: Ranger
    Text: It only grows here. It takes ten years to bloom... and only lasts for two
      days!
    Choices: []
    DefaultNextNodeID: 4
    EventTrigger: {fileID: 0}
  - NodeID: 4
    SpeakerName: Ranger
    Text: People in town... they would just pick it and let it die in a vase!
    Choices: []
    DefaultNextNodeID: 5
    EventTrigger: {fileID: 0}
  - NodeID: 5
    SpeakerName: Player
    Text: I will make sure to leave it alone.
    Choices: []
    DefaultNextNodeID: 6
    EventTrigger: {fileID: 0}
  - NodeID: 6
    SpeakerName: Ranger
    Text: Good, but now that you mentioned it, please leave me alone too, I gotta
      get some rest soon.
    Choices: []
    DefaultNextNodeID: 
    EventTrigger: {fileID: 0}
