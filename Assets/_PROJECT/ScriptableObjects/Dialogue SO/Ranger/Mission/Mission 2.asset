  Nodes:
  - NodeID: Start
    SpeakerName: Ranger
    Text: Finally, there you are! What took you so long?
    Choices: []
    DefaultNextNodeID: 1
    EventTrigger: {fileID: 0}
  - NodeID: 1
    SpeakerName: Player
    Text: I don't have a supercar, Ranger! I'm moving as fast as this engine allows.
    Choices: []
    DefaultNextNodeID: 2
    EventTrigger: {fileID: 0}
  - NodeID: 2
    SpeakerName: Ranger
    Text: Your bike is loud and slow. A bad combination for my forest!
    Choices: []
    DefaultNextNodeID: 3
    EventTrigger: {fileID: 0}
  - NodeID: 3
    SpeakerName: Player
    Text: I'll try to be faster and quieter on the way back.
    Choices: []
    DefaultNextNodeID: 4
    EventTrigger: {fileID: 0}
  - NodeID: 4
    SpeakerName: Ranger
    Text: See that you do. Ok, so I will just give you the parcel, deliver it safe
      and sound for me, take care!
    Choices: []
    DefaultNextNodeID: 
    EventTrigger: {fileID: 0}
